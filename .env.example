# Personal Website Portfolio - Environment Variables
# Copy this file to .env.local and fill in values as needed

# ============================================================
# OPTIONAL: Site URL
# ============================================================
# Used for generating canonical URLs, OG images, and sitemap
# Leave empty for local development; set for production
NEXT_PUBLIC_SITE_URL=

# ============================================================
# OPTIONAL: Analytics (Vercel)
# ============================================================
# These are automatically injected by Vercel when deployed
# No manual configuration needed for Vercel deployments
# VERCEL_ANALYTICS_ID=

# ============================================================
# REQUIRED: Email Subscriptions (Resend)
# ============================================================
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# The "From" address for subscription emails (must match your verified Resend domain)
FROM_EMAIL=Muhammad Gane <notifications@muhammadgane.com>

# ============================================================
# REQUIRED: Notification API Protection
# ============================================================
# A secret string used to authenticate the notification script.
# Generate one with: openssl rand -hex 32
NOTIFY_SECRET=

# ============================================================
# REQUIRED: Neon Postgres (via Vercel Marketplace)
# ============================================================
# Automatically set by Vercel when you add a Neon Postgres integration.
# For local development, copy from: Vercel Dashboard → Storage → Your DB → .env.local tab
POSTGRES_URL=

# ============================================================
# NOTES
# ============================================================
# - Core site functionality still works without these keys (static MDX content)
# - Subscription features require Resend + Vercel Postgres
# - Never commit actual secrets to version control
